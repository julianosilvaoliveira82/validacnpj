{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "validacnpj",
  "main": "worker.js",
  "compatibility_date": "2026-05-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
